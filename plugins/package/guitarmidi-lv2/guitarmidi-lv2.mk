######################################
#
# guitarmidi-lv2
#
######################################

# where to find the source code - locally in this case
GUITARMIDI_LV2_SITE_METHOD = local
GUITARMIDI_LV2_SITE = /home/gerald/workspace/src/GuitarMidi-LV2

# even though this is a local build, we still need a version number
# bump this number if you need to force a rebuild
GUITARMIDI_LV2_VERSION = v2.0-1

# dependencies (list of other buildroot packages, separated by space)
# the plugin's standalone CMake build needs the host cmake binary
GUITARMIDI_LV2_DEPENDENCIES = host-cmake
#GUITARMIDI_LV2_DEPENDENCIES += libmodla

# LV2 bundles generated by this package (space separated list)
GUITARMIDI_LV2_BUNDLES = guitarmidi.lv2

# The self-contained MOD build lives in hardware/moddevices: it compiles the
# plugin and stages the plugin TTL, the ArtiString modgui and the factory
# presets into one guitarmidi.lv2 bundle.
GUITARMIDI_LV2_CMAKE_DIR = $(@D)/hardware/moddevices
GUITARMIDI_LV2_BUILD_DIR = $(GUITARMIDI_LV2_CMAKE_DIR)/build-duox
GUITARMIDI_LV2_CMAKE = $(HOST_DIR)/usr/bin/cmake

# configure with the buildroot cross toolchain, then build only the plugin
define GUITARMIDI_LV2_BUILD_CMDS
	mkdir -p $(GUITARMIDI_LV2_BUILD_DIR)
	cd $(GUITARMIDI_LV2_BUILD_DIR) && \
		$(TARGET_MAKE_ENV) $(TARGET_CONFIGURE_OPTS) \
		$(GUITARMIDI_LV2_CMAKE) $(GUITARMIDI_LV2_CMAKE_DIR) \
			-DCMAKE_INSTALL_PREFIX=/usr/lib/lv2 \
			-DCMAKE_BUILD_TYPE=Release
	$(TARGET_MAKE_ENV) $(MAKE) -C $(GUITARMIDI_LV2_BUILD_DIR) guitarmidi
endef

# DESTDIR is supplied by buildroot; cmake installs to /usr/lib/lv2/guitarmidi.lv2
define GUITARMIDI_LV2_INSTALL_TARGET_CMDS
	cd $(GUITARMIDI_LV2_BUILD_DIR) && \
		$(HOST_MAKE_ENV) DESTDIR=$(TARGET_DIR) $(GUITARMIDI_LV2_CMAKE) -P cmake_install.cmake
endef

# import everything else from the buildroot generic package
$(eval $(generic-package))
